# ARES X v9 — API key configuration
# Copy this to ~/.config/ares-x/env and fill in your keys.
# All are free tiers — no credit card required for any of them.
#
# Gemini (primary):     https://aistudio.google.com  → Get API key
# Groq (secondary):     https://console.groq.com     → API Keys
# OpenRouter (tertiary): https://openrouter.ai/keys   → Create Key
#   (free to create, free to use on ":free"-suffixed models —
#    OpenRouter's free tier still requires a real key, just no billing)

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional — only needed for the HuggingFace fallback tier
HF_TOKEN=
